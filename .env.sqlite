# Local development configuration — SQLite, no extra services needed.
# setup.bat copies this to .env. Safe for local testing only, NOT production.

APP_NAME="Kuwait Manpower SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuwait
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite: a single file, no database server to install.
# (DB_DATABASE is intentionally omitted so it defaults to database/database.sqlite)
DB_CONNECTION=sqlite

# No Redis needed locally.
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

APP_CURRENCY=KWD
IDENTITY_DEFAULT_DRIVER=fake
BLOCK_REGISTRY_VISIBILITY=anonymized
BLOCK_REGISTRY_REQUIRE_EVIDENCE=true
SUBSCRIPTION_GRACE_DAYS=14
