APP_NAME="Kuwait Manpower SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuwait
APP_URL=http://localhost
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Stable, secure default: PostgreSQL 16 (MySQL 8 also supported).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=manpower_saas
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# First-party SPA / mobile session domains for Sanctum.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# ---------------------------------------------------------------------------
# Currency / locale
# ---------------------------------------------------------------------------
APP_CURRENCY=KWD

# ---------------------------------------------------------------------------
# Identity reading (§5). Default driver used when an agency has no preference.
# Drivers: paci | hawyti | smartcard | mrz_ocr | fake
# ---------------------------------------------------------------------------
IDENTITY_DEFAULT_DRIVER=fake
PACI_BASE_URL=
PACI_API_KEY=
PACI_CLIENT_ID=
HAWYTI_BASE_URL=
HAWYTI_API_KEY=
MRZ_OCR_BASE_URL=
MRZ_OCR_API_KEY=

# ---------------------------------------------------------------------------
# Block registry governance (§4). visibility: full | anonymized | vendor_mediated
# ---------------------------------------------------------------------------
BLOCK_REGISTRY_VISIBILITY=anonymized
BLOCK_REGISTRY_REQUIRE_EVIDENCE=true

# ---------------------------------------------------------------------------
# Subscription lifecycle (§2). Days of grace after expiry before lock.
# ---------------------------------------------------------------------------
SUBSCRIPTION_GRACE_DAYS=14
